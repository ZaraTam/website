{
  "name": "personal-website",
  "version": "1.0.0",
  "description": "Personal website with Google Analytics tracking tests",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ga": "jest test/ga-tracking.test.js",
    "serve": "bundle exec jekyll serve",
    "build": "bundle exec jekyll build"
  },
  "keywords": ["website", "analytics", "tracking"],
  "author": "Zara",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/test/setup.js"],
    "collectCoverageFrom": [
      "assets/js/**/*.js",
      "!**/node_modules/**"
    ]
  }
}